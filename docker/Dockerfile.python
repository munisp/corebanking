# Multi-stage Dockerfile for Python microservices
# Usage: docker build -f docker/Dockerfile.python --build-arg SERVICE=batch-processing-py -t 54bank/batch .

ARG SERVICE
FROM python:3.12-slim
WORKDIR /app
RUN adduser --system --uid 1001 appuser
COPY services/${SERVICE}/requirements.txt* ./
RUN pip install --no-cache-dir -r requirements.txt 2>/dev/null || true
COPY services/${SERVICE}/ .
COPY services/middleware-py/ /app/middleware-py/
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT:-8100}/healthz')" || exit 1
USER appuser
CMD ["python", "service.py"]
