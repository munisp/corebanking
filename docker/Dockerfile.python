# ── Generic build for Python services (services/*-py) ───────────────────────
# Referenced by docker-compose.yml with:
#   build: { context: ., dockerfile: docker/Dockerfile.python, args: { SERVICE: <dir> } }
# Each target service ships service.py + requirements.txt.

FROM python:3.12-slim
ARG SERVICE
RUN test -n "$SERVICE" || { echo "SERVICE build arg is required"; exit 1; }
WORKDIR /app
COPY services/${SERVICE}/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY services/${SERVICE}/ ./
RUN useradd --system --uid 10001 appuser && chown -R appuser /app
USER appuser
ENV PORT=8080 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/healthz' % os.environ.get('PORT','8080'), timeout=4)" || exit 1
CMD ["python", "service.py"]
