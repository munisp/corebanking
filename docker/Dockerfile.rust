# Multi-stage Dockerfile for Rust microservices
# Usage: docker build -f docker/Dockerfile.rust --build-arg SERVICE=bulk-payments-rs -t 54bank/bulk-payments .

ARG SERVICE
FROM rust:1.77-slim AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/${SERVICE}/ .
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y libssl3 ca-certificates wget && rm -rf /var/lib/apt/lists/*
RUN adduser --system --uid 1001 appuser
COPY --from=builder /app/target/release/* /usr/local/bin/ 2>/dev/null || true
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://localhost:${PORT:-8100}/healthz || exit 1
USER appuser
ENTRYPOINT ["/usr/local/bin/service"]
