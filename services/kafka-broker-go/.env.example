# --- Service Configuration ---
PORT=6379
ENV=development
LOG_LEVEL=info

# --- Database (optional — service degrades gracefully without DB) ---
DATABASE_URL=postgresql://user:password@localhost:5432/kafka_broker

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Security ---
JWT_SECRET=change-me-in-production
CORS_ALLOWED_ORIGINS=https://dashboard.54bank.ng

# --- Middleware ---
KAFKA_BROKERS=localhost:9092
KAFKA_SCHEMA_REGISTRY=http://localhost:8081
