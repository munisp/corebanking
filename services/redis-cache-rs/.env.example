# --- Service Configuration ---
PORT=8306
ENV=development
LOG_LEVEL=info

# --- Database (optional — service degrades gracefully without DB) ---
DATABASE_URL=postgresql://user:password@localhost:5432/redis_cache

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Security ---
JWT_SECRET=change-me-in-production
RUST_LOG=info

# --- Middleware ---
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_ENABLED=false
