# Telegram Banking Service Environment Variables

# Service Port
PORT=8123

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/54link-dev

# Redis Configuration
REDIS_URL=localhost:6379

# Kafka Configuration
KAFKA_BROKERS=localhost:9092

# TigerBeetle Configuration
TIGERBEETLE_ADDR=localhost:3000

# Tenant Configuration
TENANT_ID=default

# Authentication & Authorization
KEYCLOAK_URL=http://localhost:8080
PERMIFY_URL=http://localhost:3476

# Data Services
LAKEHOUSE_URL=http://localhost:8181
FLUVIO_URL=localhost:9003

# Workflow Engine
TEMPORAL_HOST=localhost:7233
