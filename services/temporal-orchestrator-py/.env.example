# --- Service Configuration ---
PORT=6379
ENV=development
LOG_LEVEL=info

# --- Database (optional — service degrades gracefully without DB) ---
DATABASE_URL=postgresql://user:password@localhost:5432/temporal_orchestrator

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Security ---
JWT_SECRET=change-me-in-production
CORS_ALLOWED_ORIGINS=https://dashboard.54bank.ng

# --- Middleware ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=54bank
