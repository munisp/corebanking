// ============================================================================
// Wave-12 B5-P1-D-F: analytics/reporting + notification + workflow schema
// FRAGMENT (Permify wave 2, batch D-F). Merged into the canonical v2.perm by
// the integrator; kept in a separate file so the canonical-schema owner
// (B5-P0-D1), the kyc fragment owner (B5-P0-D2/D3) and the D-A..D-D batch
// owners never share an edit surface with this batch. Syntax identical to
// v2.perm; the `user` entity is declared in the canonical file and referenced
// here by type only. ONLY genuinely new domain entities live here — every
// entity name was collision-checked against v2.perm, v2-kyc-compliance,
// v2-core-domain[/-py/-rs], v2-workflow and v2-money-wave2 fragments (see
// codemods/p1d-f/forbidden-entities.json); canonical entities are REUSED,
// never redefined.
//
// Convention: every mutating handler checks
//   subject = verified JWT identity, resource = <entity>:<domain-id>,
//   permission = <entity>.<action> as defined below. Checks fail closed
//   (Permify unreachable -> 502, denied -> 403) via the batch guard modules.
// User-facing "my notifications" reads stay ownership-filtered inside the
// handlers (per D1/D-A precedent only mutating routes + admin template
// management are Permify-enforced here).
// ============================================================================

entity alert_rule {
  relation admin    @user
  relation operator @user
  relation approver @user
  relation auditor  @user

  permission view   = admin or operator or approver or auditor
  permission create = admin or operator
  permission update = admin or operator
  permission delete = admin
  permission settlements = admin or operator
}

