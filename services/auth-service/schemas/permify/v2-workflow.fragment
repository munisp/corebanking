// ============================================================================
// Wave-12 B5-P1-D-A: workflow archetype schema FRAGMENT (Permify wave 2).
// Merged into the canonical v2.perm by the integrator; kept in a separate
// file so the canonical-schema owner (B5-P0-D1) and the kyc fragment owner
// (B5-P0-D2) never share an edit surface with this batch. Syntax identical
// to v2.perm; the `user` entity is declared in the canonical file and
// referenced here by type only.
//
// Convention: every mutating handler in the workflow fleet checks
//   subject = verified JWT identity, resource = <entity>:<domain-id>,
//   permission = <entity>.<action> as defined below. Checks fail closed
//   (Permify unreachable -> 502, denied -> 403) via permify_guard.go.
// ============================================================================

entity approval_flow {
  relation admin    @user
  relation operator @user
  relation approver @user
  relation auditor  @user

  permission view   = admin or operator or approver or auditor
  permission create = admin or operator
  permission update = admin or operator
  permission delete = admin
  permission manage = admin or operator
  permission process = admin or operator
  permission score = admin or operator
  permission validate = admin or operator
}

