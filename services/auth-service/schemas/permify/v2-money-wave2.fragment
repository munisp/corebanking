// ============================================================================
// Wave-12 B5-P1-D-D: money-movement wave-2 / ledger / kyc-compliance schema
// FRAGMENT. Merged into the canonical v2.perm by the integrator; kept in a
// separate file so the canonical-schema owner (B5-P0-D1) and the kyc fragment
// owner (B5-P0-D2/D3) never share an edit surface with this batch. Syntax
// identical to v2.perm; the `user` entity is declared in the canonical file
// and referenced here by type only. ONLY genuinely new domain entities live
// here — canonical entities (account, transfer, settlement, payment_order,
// facility, sweep, terminal, journal_entry, savings, derivative, kyc_case,
// aml_case, ubo_graph, regulatory_filing, regulatory_scenario, fraud_case,
// identity_verification, kyb_application, coa_mapping, ...) are REUSED, never
// redefined.
//
// Convention: every mutating handler checks
//   subject = verified JWT identity, resource = <entity>:<domain-id>,
//   permission = <entity>.<action> as defined below. Checks fail closed
//   (Permify unreachable -> 502, denied -> 403) via the batch guard modules.
// ============================================================================

entity contingent_liability {
  relation admin    @user
  relation operator @user
  relation approver @user
  relation auditor  @user

  permission view   = admin or operator or approver or auditor
  permission create = admin or operator
  permission update = admin or operator
  permission delete = admin
}

