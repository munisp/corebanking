// ============================================================================
// W12-B5-P1-D-C: core-domain-py + kyc/compliance-py schema FRAGMENT
// (69 Python services, permify wave 2 batch D-C). This fragment is merged
// into the canonical v2.perm by the integrator; it is kept in a separate
// file so peer batches (D-A/D-B/D1/D2) never edit the same file. Syntax is
// identical to v2.perm. The `user` entity is declared in the canonical file
// and referenced here by type only.
//
// Convention: every domain route in the D-C fleet checks
//   subject = verified JWT sub (user), resource = <entity>:<domain-id>,
//   permission = <entity>.<action> as defined below. Checks fail closed.
// Reused entities (NOT redefined here): v2.perm `service_config`
// (W12-B5D1, api/v1/service_configs cluster) and v2-kyc-compliance.fragment
// `kyb_application` (business-service POST /business/kyb/complete).
// ============================================================================

// KYC records served by the kyc engine cluster (kyc-engine-py, kyb-engine-py,
// kyc-data-quality-py, kyc-event-consumer-py, kyc-self-service-py,
// kyc-analytics-dashboard-py, efass-kyc-returns-py).
entity kyc_record {
  relation admin   @user
  relation manager @user
  relation viewer  @user

  permission view   = admin or manager or viewer
  permission create = admin or manager
  permission update = admin or manager
  permission delete = admin
  permission manage = admin or manager
}

// Compliance records served by the regulatory/compliance cluster
// (aml-compliance-dashboard-py, cbn-compliance-checker-py, cbn-returns-py,
// gl-regulatory-pipeline-py, regulatory-automation-py,
// regulatory-reporting-py).
entity compliance_record {
  relation admin   @user
  relation manager @user
  relation viewer  @user

  permission view   = admin or manager or viewer
  permission create = admin or manager
  permission update = admin or manager
  permission delete = admin
  permission manage = admin or manager
}

