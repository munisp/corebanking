// ============================================================================
// Wave-12 B5-P1-D-E: agri/geo + auth/security + gateway schema FRAGMENT
// (Permify wave 2, batch D-E). Merged into the canonical v2.perm by the
// integrator; kept in a separate file so the canonical-schema owner
// (B5-P0-D1), the kyc fragment owner (B5-P0-D2/D3) and the peer batches
// D-A/D-B/D-C/D-D never share an edit surface with this batch. Syntax
// identical to v2.perm; the `user` entity is declared in the canonical
// file and referenced here by type only.
//
// Convention: every mutating handler in the batch checks
//   subject = verified JWT identity, resource = <entity>:<domain-id>,
//   permission = <entity>.<action> as defined below. Checks fail closed
//   (Permify unreachable -> 502/503, denied -> 403) via permify_guard.go
//   / permify_guard.py / permify_check (rust).
// ============================================================================

// acgsf_guarantee — go route /v1/alerts (acgsf-guarantee-go)
entity acgsf_guarantee {
  relation admin    @user
  relation operator @user
  relation approver @user
  relation auditor  @user

  permission create = admin or operator
  permission delete = admin
  permission manage = admin or operator
  permission process = admin or operator
  permission risk_assess = admin or operator
  permission update = admin or operator
  permission view   = admin or operator or approver or auditor
  permission yield_score = admin or operator
}

