# --- Service Configuration ---
PORT=6379
ENV=development
LOG_LEVEL=info

# --- Database (optional — service degrades gracefully without DB) ---
DATABASE_URL=postgresql://user:password@localhost:5432/keycloak_enforcer

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Security ---
JWT_SECRET=change-me-in-production
CORS_ALLOWED_ORIGINS=https://dashboard.54bank.ng

# --- Middleware ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=54bank
KEYCLOAK_CLIENT_ID=admin-cli
