# SMS Banking Service Environment Variables

# Service Port
PORT=8104

# SMS Provider Configuration
SMS_PROVIDER=twilio
SMS_API_KEY=your_api_key
SMS_API_SECRET=your_api_secret
SMS_FROM_NUMBER=your_from_number

# Redis Configuration
REDIS_URL=localhost:6379

# Kafka Configuration
KAFKA_BROKERS=localhost:9092

# TigerBeetle Configuration
TIGERBEETLE_ADDR=localhost:3000

# Authentication & Authorization
KEYCLOAK_URL=http://localhost:8080
PERMIFY_URL=http://localhost:3476

# Data Services
LAKEHOUSE_URL=http://localhost:8181
FLUVIO_URL=localhost:9003

# Workflow Engine
TEMPORAL_HOST=localhost:7233

# Dapr Configuration
DAPR_URL=http://localhost:3500

# Tenant Configuration
TENANT_ID=default
