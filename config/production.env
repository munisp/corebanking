# 54Bank Production Environment Configuration
NODE_ENV=production
PORT=3000

# Authentication
ENABLE_AUTH=true
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_POOL_MIN=5
DB_POOL_MAX=50

# Keycloak
KEYCLOAK_URL=${KEYCLOAK_URL}
KEYCLOAK_REALM=54bank
KEYCLOAK_CLIENT_ID=54bank-platform
KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET}

# Kafka
KAFKA_BROKERS=${KAFKA_BROKERS}
KAFKA_CLIENT_ID=54bank-platform
KAFKA_GROUP_ID=54bank-consumer-group

# Redis
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}

# Temporal
TEMPORAL_ADDRESS=${TEMPORAL_ADDRESS}
TEMPORAL_NAMESPACE=54bank-production

# TigerBeetle
TIGERBEETLE_ADDRESS=${TIGERBEETLE_ADDRESS}
TIGERBEETLE_CLUSTER_ID=0

# Security
RATE_LIMIT_READS=300
RATE_LIMIT_WRITES=60
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=30
CSRF_ENABLED=true
CORS_ORIGIN=https://app.54bank.ng

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=info
SENTRY_DSN=${SENTRY_DSN}
