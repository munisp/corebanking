{
  "dashboard": {
    "title": "54Bank Service Overview",
    "panels": [
      {
        "title": "Request Rate by Service",
        "type": "graph",
        "targets": [{"expr": "sum(rate(requests_total[5m])) by (service)"}]
      },
      {
        "title": "Error Rate by Service",
        "type": "graph",
        "targets": [{"expr": "sum(rate(errors_total[5m])) by (service) / sum(rate(requests_total[5m])) by (service)"}]
      },
      {
        "title": "Active Services",
        "type": "stat",
        "targets": [{"expr": "count(up == 1)"}]
      },
      {
        "title": "DB Connection Pool Usage",
        "type": "gauge",
        "targets": [{"expr": "db_pool_active / db_pool_size"}]
      },
      {
        "title": "Rate Limit Rejections",
        "type": "graph",
        "targets": [{"expr": "sum(rate(rate_limit_rejected_total[5m])) by (service)"}]
      },
      {
        "title": "Circuit Breaker States",
        "type": "table",
        "targets": [{"expr": "circuit_breaker_state"}]
      }
    ]
  }
}
