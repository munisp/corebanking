# ProxySQL Configuration for Mojaloop MySQL
# Connection pooling + query routing + read/write split

datadir="/var/lib/proxysql"

admin_variables = {
    admin_credentials = "admin:54bank_proxysql_admin"
    mysql_ifaces = "0.0.0.0:6032"
}

mysql_variables = {
    threads = 16
    max_connections = 4096
    default_query_delay = 0
    default_query_timeout = 30000
    have_compress = true
    poll_timeout = 2000
    interfaces = "0.0.0.0:6033"
    default_schema = "central_ledger"
    stacksize = 1048576
    server_version = "8.0.35"
    connect_timeout_server = 3000
    monitor_username = "proxysql_monitor"
    monitor_password = "monitor_pass"
    monitor_history = 600000
    monitor_connect_interval = 60000
    monitor_ping_interval = 10000
    monitor_read_only_interval = 1500
    monitor_read_only_timeout = 500
    ping_interval_server_msec = 120000
    ping_timeout_server = 500
    commands_stats = true
    sessions_sort = true
    connect_retries_on_failure = 10
    multiplexing = true
    connection_max_age_ms = 300000
}

# MySQL Servers — Primary + Read Replicas
mysql_servers = (
    {
        address = "mojaloop-mysql-primary"
        port = 3306
        hostgroup = 10          # Writer hostgroup
        max_connections = 512
        weight = 1000
        compression = 0
    },
    {
        address = "mojaloop-mysql-replica-1"
        port = 3306
        hostgroup = 20          # Reader hostgroup
        max_connections = 512
        weight = 500
    },
    {
        address = "mojaloop-mysql-replica-2"
        port = 3306
        hostgroup = 20
        max_connections = 512
        weight = 500
    }
)

# Query Rules — Read/Write Split
mysql_query_rules = (
    {
        rule_id = 1
        active = 1
        match_digest = "^SELECT.*FOR UPDATE"
        destination_hostgroup = 10      # Writes go to primary
        apply = 1
    },
    {
        rule_id = 2
        active = 1
        match_digest = "^SELECT"
        destination_hostgroup = 20      # Reads go to replicas
        apply = 1
    },
    {
        rule_id = 100
        active = 1
        match_digest = ".*"
        destination_hostgroup = 10      # Everything else to primary
        apply = 1
    }
)

mysql_users = (
    {
        username = "central_ledger"
        password = "CHANGE_ME"
        default_hostgroup = 10
        max_connections = 1024
        transaction_persistent = 1
        active = 1
    }
)
