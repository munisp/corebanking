{
  "uid": "cb-money-path",
  "title": "Corebanking \u2014 Money Path (per-tenant)",
  "tags": [
    "corebanking",
    "money-path",
    "tenant",
    "wave9"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_request_duration_seconds_count, tenant_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Platform Overview",
      "type": "link",
      "url": "/d/cb-platform-overview",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Money-path request rate by tenant",
      "description": "Money-route traffic per tenant. tenant_id label exists ONLY on money-path services (SPEC \u00a72.3 cardinality guard); other services never emit this label.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant_id, service_name) (rate(http_server_request_duration_seconds_count{tenant_id=~\"$tenant_id\", http_route=~\".*(payment|payout|disburse|transfer|settlement|ledger|transaction).*\"}[5m]))",
          "legendFormat": "{{tenant_id}} {{service_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Money-path p95 latency by tenant",
      "description": "Backs the MoneyPathLatencyP95 alert family.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tenant_id) (rate(http_server_request_duration_seconds_bucket{tenant_id=~\"$tenant_id\", http_route=~\".*(payment|payout|disburse|transfer|settlement|ledger|transaction).*\"}[5m])))",
          "legendFormat": "{{tenant_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Money-path 5xx ratio by tenant",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant_id) (rate(http_server_request_duration_seconds_count{tenant_id=~\"$tenant_id\", http_response_status_code=~\"5..\"}[5m])) / sum by (tenant_id) (rate(http_server_request_duration_seconds_count{tenant_id=~\"$tenant_id\"}[5m]))",
          "legendFormat": "{{tenant_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Payment services request rate (all routes, per tenant)",
      "description": "Priority-three money services (SPEC \u00a76). Empty series = either no traffic or the kit is not attaching tenant.id \u2014 both worth investigating.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant_id, service_name) (rate(http_server_request_duration_seconds_count{tenant_id=~\"$tenant_id\", service_name=~\"payment-processing-service|payment-hub|mojaloop-connector\"}[5m]))",
          "legendFormat": "{{service_name}} {{tenant_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Money-path traces for selected tenant (Tempo)",
      "description": "TraceQL search scoped to span.tenant.id. tenant.id is preserved end-to-end (collector never drops it; tail-sampling keeps 100% of these spans).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceqlSearch",
          "query": "{span.tenant.id = \"$tenant_id\"}",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Money-path service logs (Loki)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_namespace=\"corebanking\"} |= `` | json | tenant_id=~\"$tenant_id\""
        }
      ]
    }
  ]
}