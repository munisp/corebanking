# 54Bank Platform — Environment Configuration
# Copy to .env and fill in values

# Required
DATABASE_URL=postgresql://bank54_user:CHANGE_ME@localhost:5432/bank54_db
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
NODE_ENV=production

# Authentication
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_REALM=54bank

# Middleware
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
TEMPORAL_ADDRESS=localhost:7233
OPENSEARCH_URL=http://localhost:9200
MOJALOOP_HUB_URL=http://localhost:4000
TIGERBEETLE_ADDRESS=localhost:3000
FLUVIO_ADDR=localhost:9003
LAKEHOUSE_API_URL=http://localhost:8085

# External Integrations
NIBSS_API_KEY=CHANGE_ME
PAYSTACK_SECRET_KEY=CHANGE_ME
FLUTTERWAVE_SECRET_KEY=CHANGE_ME
SMS_API_KEY=CHANGE_ME

# Email
SMTP_HOST=smtp.54bank.ng
SMTP_PORT=587

# Platform
PLATFORM_TENANT_SECRET=CHANGE_ME
APP_ID=54bank-platform
ADMIN_USER_ID=admin

# Feature Flags
ENABLE_AUTH=true
ENABLE_AUDIT=true
ENABLE_RATE_LIMIT=true


# Temporal — Durable workflow orchestration
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=54bank
TEMPORAL_TASK_QUEUE=54bank-banking

# OpenAppSec — ML-based WAF
OPENAPPSEC_TOKEN=local-dev-token
OPENAPPSEC_UPSTREAM=http://apisix:9080
OPENAPPSEC_LOG_LEVEL=info

# Fluvio — Streaming platform
FLUVIO_ENDPOINT=fluvio:9003
FLUVIO_LOG=info

# Dapr — Distributed application runtime
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_PUBSUB_NAME=54bank-pubsub
DAPR_STATE_STORE=54bank-statestore
DAPR_SECRET_STORE=54bank-secrets

# ─── LLM / AI Services (standard OpenAI-compatible) ──────────────────────────
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
IMAGE_GEN_MODEL=dall-e-3
WHISPER_MODEL=whisper-1

# ─── Object Storage (S3-compatible: AWS S3, MinIO, Cloudflare R2) ─────────────
S3_BUCKET_NAME=54bank-storage
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# S3_ENDPOINT=http://minio:9000        # Uncomment for MinIO/R2/custom endpoint
# S3_PUBLIC_BASE_URL=https://cdn.54bank.example.com  # Uncomment for CDN

# ─── Notifications (standard webhook) ─────────────────────────────────────────
NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ─── External Data APIs ────────────────────────────────────────────────────────
DATA_API_BASE_URL=https://your-data-api.example.com
DATA_API_KEY=your-data-api-key

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
